{
  "name": "over15-scanner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron-dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && cross-env ELECTRON_DEV=1 electron .\"",
    "electron-build": "next build && node scripts/copy-standalone.js && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  },
  "main": "electron-main.js",
  "build": {
    "appId": "com.over15.scanner",
    "productName": "Over 1.5 Scanner",
    "directories": {
      "output": "dist4"
    },
    "files": [
      "electron-main.js",
      "package.json",
      ".next/standalone/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Over 1.5 Scanner"
    },
    "npmRebuild": false,
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false
  }
}